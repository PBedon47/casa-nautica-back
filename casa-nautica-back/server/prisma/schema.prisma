generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"
  url = env("DATABASE_URL") }
model Event {
  id       Int @id @default(1)
  total    Int @default(890)
  houseFee Int @default(50)
  extraFee Int @default(0)
}
model Guest {
  id        Int      @id @default(autoincrement())
  name      String
  nameKey   String   @unique
  going     Boolean
  email     String   @default("")
  phone     String   @default("")
  music     String   @default("")
  food      String   @default("")
  paidHouse Boolean  @default(false)
  paidExtra Boolean  @default(false)
  createdAt DateTime @default(now())
}
